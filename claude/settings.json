{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node ~/.claude/tools/generate-image.mjs *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm ls)",
      "Bash(npm ls *)",
      "Bash(npx tsc *)",
      "Bash(npx tsx *)",
      "Bash(npx prisma *)",
      "Bash(npx next *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx jest *)",
      "Bash(npx playwright *)",
      "Bash(npm ci *)",
      "Bash(pkill -f *)",
      "Bash(/Users/ethan/.claude/plugins/cache/claude-plugins-official/superpowers/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git push *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git ls-files *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(cd *)",
      "Bash(docker compose *)",
      "Bash(curl *)",
      "Bash(gh *)",
      "Bash(railway status *)",
      "Bash(railway logs *)",
      "Bash(railway variables *)",
      "Bash(railway list)",
      "Bash(railway whoami)",
      "Bash(xcrun simctl list)",
      "Bash(xcrun simctl list *)",
      "Bash(xcrun simctl listapps *)",
      "Bash(lsof *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools",
      "mcp__plugin_context7_context7",
      "mcp__plugin_playwright_playwright",
      "mcp__plugin_posthog_posthog",
      "mcp__plugin_stripe_stripe"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "(command -v afplay >/dev/null && afplay -v 1 /System/Library/Sounds/Bottle.aiff) || (command -v paplay >/dev/null && paplay /usr/share/sounds/freedesktop/stereo/complete.oga) || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "(command -v afplay >/dev/null && afplay -v 1 /System/Library/Sounds/Bottle.aiff) || (command -v paplay >/dev/null && paplay /usr/share/sounds/freedesktop/stereo/complete.oga) || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754032649377
  },
  "_commented_hooks_backup": {
    "Notification": "say \"Claude code needs your attention\"",
    "Stop": "say \"Main Claude code finished\"",
    "SubagentStop": "say \"Claude code subagent finished\""
  },
  "inputNeededNotifEnabled": false
}
